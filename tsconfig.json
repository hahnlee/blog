{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "noEmit": true,
    "paths": {
      "@components/*": ["./src/components/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@styles/*": ["./src/styles/*"],
      "@models/*": ["./src/models/*"]
    }
  },
  "include": ["src", "gatsby-*.ts", "gatsby-*.tsx"],
  "exclude": ["node_modules", "public", ".cache"]
}
